# Public browser configuration. Never add a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_DOCUMENTS_BUCKET=element-documents
VITE_SUPABASE_INTAKE_BUCKET=element-intake

# Public URL only. Keep the real endpoint in .env.local or a GitHub Actions secret.
# The workflow must validate the Supabase access token sent by the browser.
VITE_N8N_ELEMENTS_ASSETS_URL=

# Use "/" for Docker and "/PDMUFront/" for GitHub Pages.
VITE_BASE_PATH=/PDMUFront/
