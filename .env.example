# Public browser configuration. Never add a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_DOCUMENTS_BUCKET=element-documents

# Published n8n webhooks used by the browser.
VITE_N8N_ELEMENTS_ASSETS_URL=
VITE_N8N_OPERATORS_URL=

# Use "/" for Docker and "/PDMUFront/" for GitHub Pages.
VITE_BASE_PATH=/PDMUFront/
